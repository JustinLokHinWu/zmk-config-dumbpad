#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/ext_power.h>
#include <dt-bindings/zmk/keys.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&tog 1
&kp KP_N7   &kp KP_N8   &kp KP_N9       &kp KP_DIVIDE
&kp KP_N4   &kp KP_N5   &kp KP_N6       &kp KP_MULTIPLY
&kp KP_N1   &kp KP_N2   &kp KP_N3       &kp KP_MINUS
&kp KP_N0   &kp KP_DOT  &kp KP_ENTER    &kp KP_PLUS
            >;
        };

        layer_1 {
            bindings = <
&tog 0
&bt BT_CLR   &bt BT_PRV  &bt BT_NXT  &none
&kp KP_NUM   &kp KP_CAPS &kp KP_SLCK &none
&none        &none       &none       &none
&none        &none       &none       &none
            >;
        };

        encoder_rotate: encoder_rotate {
            compatible = "zmk,encoder-rotate";
            bindings = <&kp &kp C_VOLUME_UP &kp &kp C_VOLUME_DOWN>;
        };
    };
};
