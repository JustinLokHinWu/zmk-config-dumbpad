#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/ext_power.h>
#include <dt-bindings/zmk/keys.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&tog 1
&kp KP_N0       &kp KP_N1       &kp KP_N4       &kp KP_N7
&kp KP_DOT      &kp KP_N2       &kp KP_N5       &kp KP_N8
&kp KP_ENTER    &kp KP_N3       &kp KP_N6       &kp KP_N9
&kp KP_PLUS     &kp KP_MINUS    &kp KP_MULTIPLY &kp KP_DIVIDE
            >;
            
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        layer_1 {
            bindings = <
&tog 1
&none           &none           &kp KP_NUM      &bt BT_CLR
&none           &none           &kp CAPS        &bt BT_PRV
&none           &none           &kp SLCK        &bt BT_NXT
&none           &none           &none           &none
            >;
            
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };
    };
};