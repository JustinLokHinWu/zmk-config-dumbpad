#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/ext_power.h>
#include <dt-bindings/zmk/keys.h>

/ {
    sensors {
        compatible = "zmk,keymap-sensors";
        sensors = <&left_encoder>;
        triggers-per-rotation = <24>;
    };
    
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&tog 1
&kp KP_N7   &kp KP_N8   &kp KP_N9       &kp KP_DIVIDE
&kp KP_N4   &kp KP_N5   &kp KP_N6       &kp KP_MULTIPLY
&kp KP_N1   &kp KP_N2   &kp KP_N3       &kp KP_MINUS
&kp KP_N0   &kp KP_DOT  &kp KP_ENTER    &kp KP_PLUS
            >;
            
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        layer_1 {
            bindings = <
&tog 1
&bt BT_CLR   &bt BT_SEL 0   &bt BT_SEL 1   &bt BT_SEL 2
&kp KP_NUM   &kp CAPS     &kp SLCK     &none
&none        &none        &none        &none
&none        &none        &none        &none
            >;
            
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };
    };
};